    Serial.print(z);
    Serial.print('\t');*/


    
    float degacc= atan(ay/az)*180/PI;
    
    degt=kg*degx+ka*degacc;
    
    if(Serial.available()> 0){ 
    
    userInput = Serial.read();               // read user input
      
      if(userInput == 'g'){                  // if we get expected value 

          Serial.print(degt);
          Serial.print(",");
          Serial.print(degx);
          Serial.print(",");
          Serial.println(degacc);
      }
    }       

